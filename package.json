{
  "name": "website3",
  "private": true,
  "scripts": {
    "build:css": "sass docs/css/custom.scss docs/css/bootstrap-custom.css --style=compressed --no-source-map --load-path=node_modules --silence-deprecation=import,if-function,global-builtin,color-functions",
    "build:print": "sass docs/css/print.scss docs/css/print.css --style=compressed --no-source-map --load-path=node_modules --silence-deprecation=import,if-function,global-builtin,color-functions",
    "build": "npm run build:css && npm run build:print",
    "watch:css": "sass docs/css/custom.scss docs/css/bootstrap-custom.css --watch --load-path=node_modules --silence-deprecation=import,if-function,global-builtin,color-functions",
    "watch:print": "sass docs/css/print.scss docs/css/print.css --watch --load-path=node_modules --silence-deprecation=import,if-function,global-builtin,color-functions"
  },
  "devDependencies": {
    "bootstrap": "^5.3.7",
    "sass": "^1.89.2"
  }
}
